# Copy to .env (local) or add in Vercel > Project > Settings > Environment Variables. Never commit the real values.

# Gemini: reading pages, classifying competitors, drafting. MODEL is the exact API id, e.g. gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

# Neon Postgres connection string. Leave empty locally to save plans as JSON files under data/plans.
# On Vercel it is required, because the disk is not kept between requests.
DATABASE_URL=

# Apollo: contacts. Not used yet.
APOLLO_API_KEY=

# Gmail drafts and sending. Create an OAuth client (type: Web application) in Google Cloud, enable the Gmail API, and add these redirect URIs:
#   http://localhost:3000/api/google/callback
#   https://YOUR-SITE/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Encrypts the stored Gmail connection. Changing it disconnects everyone's Gmail.
APP_SECRET=
